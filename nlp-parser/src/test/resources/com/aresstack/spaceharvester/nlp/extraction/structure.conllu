4	Antrag	Antrag	NOUN	NN	_	6	nsubj:pass	_	_
5	wird	werden	AUX	VAFIN	_	6	aux:pass	_	_
6	geprüft	prüfen	VERB	VVPP	_	0	root	_	SpaceAfter=No
7	.	.	PUNCT	$.	_	6	punct	_	_

