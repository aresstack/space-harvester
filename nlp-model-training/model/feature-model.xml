<?xml version="1.0" encoding="UTF-8"?>
<!--
  Featuremodell von maltparser-de-gsd (#99) für stacklazy/LIBLINEAR. Grundlage ist MaltParsers
  appdata/features/liblinear/conllu/StackSwap.xml; ergänzt um weitere FORM-/UPOS-Merkmale des Stacks, der linken und
  rechten Abhängigen, eine Distanz und die Wortformen der linken Abhängigen (im Deutschen meist Artikel, die den Kasus
  tragen; Vorschlag aus #98). Gelesen werden nur FORM und UPOSTAG (Eingabevertrag), dazu DEPREL bereits gebauter Kanten.
  Wahl auf Dev, siehe README.md (Konfigurationswahl).
-->
<featuremodels>
	<featuremodel name="maltparser-de-gsd">
		<feature>InputColumn(UPOSTAG, Stack[0])</feature>
		<feature>InputColumn(UPOSTAG, Stack[1])</feature>
		<feature>InputColumn(UPOSTAG, Stack[2])</feature>
		<feature>InputColumn(UPOSTAG, Input[0])</feature>
		<feature>InputColumn(UPOSTAG, Lookahead[0])</feature>
		<feature>InputColumn(UPOSTAG, Lookahead[1])</feature>
		<feature>InputColumn(UPOSTAG, Lookahead[2])</feature>
		<feature>Merge(InputColumn(UPOSTAG, Stack[1]), InputColumn(UPOSTAG, Stack[0]))</feature>
		<feature>Merge3(InputColumn(UPOSTAG, Stack[2]), InputColumn(UPOSTAG, Stack[1]), InputColumn(UPOSTAG, Stack[0]))</feature>
		<feature>Merge3(InputColumn(UPOSTAG, Stack[1]), InputColumn(UPOSTAG, Stack[0]), InputColumn(UPOSTAG, Lookahead[0]))</feature>
		<feature>Merge3(InputColumn(UPOSTAG, Stack[0]), InputColumn(UPOSTAG, Lookahead[0]), InputColumn(UPOSTAG, Lookahead[1]))</feature>
		<feature>Merge3(InputColumn(UPOSTAG, Lookahead[0]), InputColumn(UPOSTAG, Lookahead[1]), InputColumn(UPOSTAG, Lookahead[2]))</feature>
		<feature>OutputColumn(DEPREL, ldep(Stack[0]))</feature>
		<feature>OutputColumn(DEPREL, rdep(Stack[0]))</feature>
		<feature>OutputColumn(DEPREL, ldep(Stack[1]))</feature>
		<feature>OutputColumn(DEPREL, rdep(Stack[1]))</feature>
		<feature>Merge3(InputColumn(UPOSTAG, Stack[0]), OutputColumn(DEPREL, ldep(Stack[0])), OutputColumn(DEPREL, rdep(Stack[0])))</feature>
		<feature>Merge3(InputColumn(UPOSTAG, Stack[1]), OutputColumn(DEPREL, ldep(Stack[1])), OutputColumn(DEPREL, rdep(Stack[1])))</feature>
		<feature>InputColumn(FORM, Stack[0])</feature>
		<feature>InputColumn(FORM, Stack[1])</feature>
		<feature>InputColumn(FORM, Lookahead[0])</feature>
		<feature>InputColumn(FORM, Lookahead[1])</feature>
		<feature>InputColumn(FORM, Stack[2])</feature>
		<feature>InputColumn(UPOSTAG, ldep(Stack[0]))</feature>
		<feature>InputColumn(UPOSTAG, rdep(Stack[0]))</feature>
		<feature>InputColumn(UPOSTAG, ldep(Stack[1]))</feature>
		<feature>InputColumn(UPOSTAG, rdep(Stack[1]))</feature>
		<feature>Merge(InputColumn(FORM, Stack[0]), InputColumn(UPOSTAG, Stack[0]))</feature>
		<feature>Merge(InputColumn(FORM, Stack[1]), InputColumn(UPOSTAG, Stack[1]))</feature>
		<feature>Merge(InputColumn(FORM, Stack[0]), InputColumn(UPOSTAG, Stack[1]))</feature>
		<feature>Merge(InputColumn(UPOSTAG, Stack[0]), InputColumn(FORM, Stack[1]))</feature>
		<feature>Merge(InputColumn(FORM, Lookahead[0]), InputColumn(UPOSTAG, Lookahead[0]))</feature>
		<feature>Merge(InputColumn(UPOSTAG, Stack[0]), Distance(Stack[0], Stack[1], 0|1|2|3|6))</feature>
		<feature>InputColumn(UPOSTAG, Lookahead[3])</feature>
		<feature>Merge(InputColumn(FORM, Stack[0]), InputColumn(FORM, Stack[1]))</feature>
		<feature>InputColumn(FORM, ldep(Stack[0]))</feature>
		<feature>InputColumn(FORM, rdep(Stack[1]))</feature>
		<feature>Merge3(InputColumn(UPOSTAG, Stack[1]), InputColumn(UPOSTAG, Stack[0]), OutputColumn(DEPREL, ldep(Stack[0])))</feature>
		<feature>Merge3(InputColumn(UPOSTAG, Stack[1]), InputColumn(UPOSTAG, Stack[0]), OutputColumn(DEPREL, rdep(Stack[1])))</feature>
		<feature>Merge(InputColumn(FORM, Stack[1]), InputColumn(UPOSTAG, Stack[0]))</feature>
		<feature>InputColumn(FORM, ldep(Stack[1]))</feature>
		<feature>Merge(InputColumn(FORM, ldep(Stack[0])), InputColumn(UPOSTAG, Stack[0]))</feature>
		<feature>Merge(InputColumn(FORM, ldep(Stack[1])), InputColumn(UPOSTAG, Stack[1]))</feature>
		<feature>Merge3(InputColumn(FORM, ldep(Stack[0])), InputColumn(UPOSTAG, Stack[0]), InputColumn(UPOSTAG, Stack[1]))</feature>
	</featuremodel>
</featuremodels>

